any where winlog.channel:"Microsoft-Windows-Sysmon/Operational" and ((event.code:"13" and (registry.path like~ ("*\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\*", "*\\Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\*"))) and (registry.data.strings like~ ("*powershell*", "*pwsh*", "*cmd.exe*", "*wscript*", "*cscript*", "*mshta*", "*rundll32*", "*\\AppData\\*", "*\\Temp\\*", "*%APPDATA%*", "*%TEMP%*")))
