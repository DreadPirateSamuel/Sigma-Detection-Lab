{
  "bool": {
    "filter": [
      {
        "wildcard": {
          "winlog.channel": {
            "value": "Microsoft-Windows-Sysmon/Operational",
            "case_insensitive": true
          }
        }
      },
      {
        "bool": {
          "filter": [
            {
              "bool": {
                "filter": [
                  {
                    "wildcard": {
                      "event.code": {
                        "value": "1",
                        "case_insensitive": true
                      }
                    }
                  },
                  {
                    "wildcard": {
                      "process.executable": {
                        "value": "*\\\\schtasks.exe",
                        "case_insensitive": true
                      }
                    }
                  }
                ]
              }
            },
            {
              "wildcard": {
                "process.command_line": {
                  "value": "* /create *",
                  "case_insensitive": true
                }
              }
            },
            {
              "bool": {
                "should": [
                  {
                    "wildcard": {
                      "process.command_line": {
                        "value": "* /tr *",
                        "case_insensitive": true
                      }
                    }
                  },
                  {
                    "wildcard": {
                      "process.command_line": {
                        "value": "* /xml *",
                        "case_insensitive": true
                      }
                    }
                  }
                ],
                "minimum_should_match": 1
              }
            }
          ]
        }
      }
    ]
  }
}
